@page "/blackjack"
@page "/blackjack/{RoomId}"
@using MihuBot.Components.Blackjack
@using MihuBot.Games.Blackjack
@inject BrowserBlackjackService Tables
@inject NavigationManager Navigation
@inject AvailableFeatures Features
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Blackjack - MihuBot</PageTitle>

<div class="blackjack-page @(RoomId is not null && _state is not null ? "table-page" : "")">
    <header class="page-heading">
        <div>
            <p class="eyebrow">THE MIHUBOT CARD ROOM</p>
            <h1>Blackjack<span class="title-dot">.</span></h1>
            <p class="subtitle">One dealer. Six seats. Play together.</p>
        </div>
        <span class="play-money">PLAY CHIPS ONLY</span>
    </header>

    @if (_error is not null && (RoomId is null || _state is null))
    {
        <div class="alert alert-warning" role="alert">@_error</div>
    }
    @if (_userId == 0)
    {
        <div class="login-note">
            @if (Features.DiscordLogin)
            {
                <a class="btn btn-light" href="@LoginUrl">Sign in with Discord</a>
                <span>to take a seat. Your chips are saved to your Discord account.</span>
            }
            else
            {
                <span>Discord sign-in is not configured on this server. Sign-in is required to play.</span>
            }
        </div>
    }

    @if (RoomId is null)
    {
        <section class="welcome">
            <div class="welcome-art" aria-hidden="true">
                <PlayingCard Card="@(new BrowserBlackjackCard(1, 3))" />
                <PlayingCard Card="@(new BrowserBlackjackCard(13, 2))" Delay="160" />
            </div>
            <h2>Your table, your company.</h2>
            <p>Start with 1,000 chips per account. Your balance follows you across tables and server restarts.</p>
            @if (_balance is decimal balance)
            {
                <p class="welcome-balance">Your available balance: <strong>@Chips(balance) chips</strong></p>
            }
            <div class="table-options">
                <label for="deck-count">Decks in the shoe</label>
                <select id="deck-count" class="form-select" @bind="_decks">
                    <option value="2">2 decks (up to 3 hands per player)</option>
                    <option value="4">4 decks (standard)</option>
                    <option value="6">6 decks</option>
                    <option value="8">8 decks</option>
                </select>
                <small>Stand on soft 17 / double after split / late surrender / up to @BlackjackShoe.GetMaxHandsPerPlayer(_decks) hands per player</small>
            </div>
            <button class="btn gold-button" disabled="@(_userId == 0 || _busy || !RendererInfo.IsInteractive)" @onclick="CreateRoom">Create a table</button>
            <div class="join-room">
                <label for="room-code">Already invited?</label>
                <div>
                    <input id="room-code" class="form-control" @bind="_roomCode" placeholder="Paste a table link or code" maxlength="300" />
                    <button class="btn btn-outline-light" @onclick="OpenRoom">Open table</button>
                </div>
            </div>
            @if (_ownedRooms.Count > 0)
            {
                <div class="existing-rooms">
                    <span>Your open tables</span>
                    @foreach (string room in _ownedRooms)
                    {
                        <a href="@($"blackjack/{room}")">Table @room[..8]</a>
                    }
                </div>
            }
        </section>
    }
    else if (_state is null)
    {
        <div class="welcome">
            <h2>Table unavailable</h2>
            <p>The host has closed this table, it has expired, or the link is invalid. Unattended tables expire after two hours.</p>
            <a class="btn gold-button" href="blackjack">Back to the card room</a>
        </div>
    }
    else
    {
        var displayed = _state;
        <div class="invite-bar">
            <a href="blackjack" class="back-link">&larr; Card room</a>
            <label for="invite-link">Invite friends</label>
            <input id="invite-link" class="form-control" value="@InviteUrl" readonly />
            <button class="btn btn-outline-light" @onclick="CopyInvite">@(_copied ? "Copied!" : "Copy link")</button>
            @if (Can(BrowserBlackjackCommand.Close))
            {
                <button class="btn btn-outline-danger" disabled="@_busy" @onclick="() => _confirmClose = true">Close table</button>
            }
        </div>

        @if (_confirmClose && Can(BrowserBlackjackCommand.Close))
        {
            <div class="close-confirm alert alert-warning" role="alert">
                <span>Close this table for everyone? Undealt bets will be refunded; active hands will be stood and settled. Saved balances are kept.</span>
                <button class="btn btn-danger" disabled="@_busy" @onclick="() => Move(BrowserBlackjackCommand.Close, displayed)">Confirm close</button>
                <button class="btn btn-outline-light" @onclick="() => _confirmClose = false">Keep table</button>
            </div>
        }

        <BlackjackBoard State="_state" ViewerId="_userId" Now="_now" />

        <div class="action-dock">
            <div class="turn-strip">
                <span>@TurnLabel</span>
                @if (_state.Lobby || _state.YourTurn)
                {
                    <span class="countdown" aria-label="@($"{SecondsLeft} seconds remaining")">@SecondsLeft s</span>
                }
                <label class="training-toggle">
                    <input type="checkbox" @bind="_showAdvice" @bind:after="Refresh" /> Strategy coach
                </label>
                @if (_userId != 0)
                {
                    <span class="your-balance">Your chips <strong>@Chips(_state.Balance)</strong></span>
                }
            </div>
            @if (_state.Lobby || _state.YourTurn)
            {
                <progress class="turn-progress" value="@SecondsLeft" max="30" aria-label="Time remaining"></progress>
            }
            <div class="controls">
                @if (Can(BrowserBlackjackCommand.Join))
                {
                    <div class="bet-controls">
                        <label for="bet">Bet</label>
                        <input id="bet" class="form-control" type="number" min="10" max="500" step="1" @bind="_bet" />
                        @foreach (int preset in new[] { 10, 25, 100, 500 })
                        {
                            <button class="bet-preset @(_bet == preset ? "selected" : "")" @onclick="() => _bet = preset">@preset</button>
                        }
                        <button class="btn gold-button" disabled="@_busy" @onclick="() => Move(BrowserBlackjackCommand.Join, displayed)">
                            @(_state.Lobby && _state.Seats.Any(p => p.Id == _userId) ? "Update bet" : "Bet & join")
                        </button>
                    </div>
                }
                @if (_state.Active && !_state.Lobby)
                {
                    @foreach (var action in PlayActions)
                    {
                        <button class="btn @(action == BrowserBlackjackCommand.Hit ? "gold-button" : "btn-outline-light")"
                                disabled="@(_busy || !Can(action))" @onclick="() => Move(action, displayed)">@ActionLabel(action)</button>
                    }
                }
                @if (Can(BrowserBlackjackCommand.Deal))
                {
                    <button class="btn gold-button" disabled="@_busy" @onclick="() => Move(BrowserBlackjackCommand.Deal, displayed)">Deal now</button>
                }
                @if (Can(BrowserBlackjackCommand.Leave))
                {
                    <button class="btn btn-outline-light" disabled="@_busy" @onclick="() => Move(BrowserBlackjackCommand.Leave, displayed)">Leave & refund</button>
                }
                @if (Can(BrowserBlackjackCommand.Rebuy))
                {
                    <button class="btn gold-button" disabled="@_busy" @onclick="() => Move(BrowserBlackjackCommand.Rebuy, displayed)">Free rebuy to 1,000</button>
                }
            </div>
            @if (_state.Advice is { } advice)
            {
                <div class="strategy-coach" aria-label="Private strategy coach">
                    <span>Running <strong>@Signed(advice.RunningCount)</strong></span>
                    <span>True <strong>@Signed(advice.TrueCount)</strong></span>
                    <span>Unseen decks <strong>@advice.UnseenDecks.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</strong></span>
                    <div class="coach-recommendation">
                        <strong class="recommended-move">@(advice.Move is { } move ? ActionLabel(move) : "No decision pending")@(advice.Deviation ? " / deviation" : "")</strong>
                        <span class="coach-explanation">@advice.Explanation</span>
                    </div>
                </div>
            }
            @if (_state.Notice is not null)
            {
                <p class="notice" role="status">@_state.Notice</p>
            }
            @if (_state.StorageError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_state.StorageError</div>
            }
            @if (_error is not null && _error != _state.StorageError)
            {
                <div class="alert alert-warning mt-3 mb-0" role="alert">@_error</div>
            }
        </div>
    }

    <details class="rules">
        <summary>Table rules &amp; how to play here</summary>
        <p>Up to six players act simultaneously against one dealer. Your split hands are played one at a time,
            but you never wait for another seat to finish. Bets are 10-500 whole chips. The first bet opens a 30-second
            betting window; the host can deal early. Each player has an independent 30-second timer per move. A timeout declines
            insurance or stands on all your remaining hands, so disconnected players cannot hold up the table.</p>
        <p>Everyone must decide on insurance before the dealer checks for blackjack or anyone plays their main hand.
            The dealer reveals and settles once all players have finished.</p>
        <p>@(_state?.DeckCount ?? _decks) decks, shuffled at 75% penetration (earlier if needed for safe splits). Dealer stands on soft 17.
            Blackjack pays 3:2. Double after splitting; split equal-value cards into up to
            @(_state?.MaxHandsPerPlayer ?? BlackjackShoe.GetMaxHandsPerPlayer(_decks)) hands per player.
            Two-deck tables allow three hands per player to safely support all six seats without mid-hand shuffles;
            larger shoes allow four.
            Split aces get one card each. Late surrender and insurance are available.</p>
        <p>Place a new bet to opt in to each round. Leaving before the deal refunds your bet.
            Closing the tab does not cancel a wager; reopen the same link to return.
            Free rebuys are available below 10 chips when you have no active wager at any table.
            Your chip balance is saved per Discord account and shared by all tables.
            Available chips exclude all your outstanding wagers. Nothing is bought or paid out.
            Tables and shoes reset on restart, with unfinished wagers returned; saved scores remain.
            Unviewed tables expire after two hours once their round finishes.</p>
        <p>Anyone with the link can watch or join. Share it only with the people you want at your table.
            Closing a lobby refunds its bets. Closing a live round declines pending insurance,
            stands unfinished hands, and saves the results before removing the table. When no one is seated,
            the table's creator can close it.</p>
    </details>
</div>

@code {
    [Parameter]
    public string RoomId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private readonly CancellationTokenSource _stop = new();
    private ClaimsPrincipal _user;
    private ulong _userId;
    private BrowserBlackjackState _state;
    private IReadOnlyList<string> _ownedRooms = [];
    private string _roomCode;
    private string _error;
    private decimal _bet = 10;
    private decimal? _balance;
    private int _decks = BlackjackShoe.Decks;
    private bool _showAdvice;
    private bool _busy;
    private bool _copied;
    private bool _confirmClose;
    private Task _updates;
    private IJSObjectReference _module;
    private DateTime _now = DateTime.UtcNow;
    private string _loadedRoom;

    private string InviteUrl => Navigation.ToAbsoluteUri($"blackjack/{RoomId}").AbsoluteUri;
    private string LoginUrl => $"Account/Login/Discord?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
    private int SecondsLeft => Math.Clamp((int)Math.Ceiling((_state.Deadline - _now).TotalSeconds), 0, 30);
    private bool Can(BrowserBlackjackCommand command) => _state?.Actions.Contains(command) == true;
    private string TurnLabel => _state.StorageError is not null ? "Waiting to save scores"
        : _state.Lobby ? "Place your bets" : _state.Complete ? "Ready for another round?"
        : !_state.Active ? "Take a seat to begin" : _state.YourTurn ? "Your move"
        : _state.Insurance ? "Waiting for insurance decisions" : "Waiting for the other players";
    private BrowserBlackjackCommand[] PlayActions => _state.Insurance
        ? [BrowserBlackjackCommand.Insure, BrowserBlackjackCommand.DeclineInsurance]
        : [BrowserBlackjackCommand.Hit, BrowserBlackjackCommand.Stand, BrowserBlackjackCommand.Double, BrowserBlackjackCommand.Split, BrowserBlackjackCommand.Surrender];

    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthenticationState).User;
        _userId = _user.GetDiscordUserId();
        _ownedRooms = Tables.GetOwnedRooms(_user);

        if (_loadedRoom != RoomId)
        {
            _loadedRoom = RoomId;
            _error = null;
            _copied = false;
            _confirmClose = false;
        }

        Refresh();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _updates = UpdateLoop();
        }

        return Task.CompletedTask;
    }

    private async Task UpdateLoop()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));

        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                await InvokeAsync(() =>
                {
                    if (!_stop.IsCancellationRequested)
                    {
                        Refresh();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private void Refresh()
    {
        _now = DateTime.UtcNow;
        string previousStorageError = _state?.StorageError;
        _state = Tables.Read(RoomId, _user, includeAdvice: _showAdvice);
        _balance = _state is not null && _userId != 0 ? _state.Balance : Tables.GetBalance(_user);

        if (previousStorageError is not null && _error == previousStorageError && _state?.StorageError is null)
        {
            _error = null;
        }
    }

    private async Task CreateRoom()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            _user = (await AuthenticationState).User;
            (string roomId, _error) = Tables.CreateRoom(_user, _decks);

            if (_error is null)
            {
                Navigation.NavigateTo($"blackjack/{roomId}");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenRoom()
    {
        string code = _roomCode?.Trim();

        if (Uri.TryCreate(code, UriKind.Absolute, out Uri uri))
        {
            code = uri.AbsolutePath.TrimEnd('/').Split('/').Last();
        }

        if (Guid.TryParseExact(code, "N", out Guid id))
        {
            Navigation.NavigateTo($"blackjack/{id:N}");
        }
        else
        {
            _error = "Enter a valid table link or the 32-character table code.";
        }
    }

    private async Task Move(BrowserBlackjackCommand command, BrowserBlackjackState displayed)
    {
        if (_busy || _state is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _user = (await AuthenticationState).User;
            _error = Tables.Execute(displayed.RoomId, _user, displayed.Version, command, _bet);
            _confirmClose = false;
            Refresh();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyInvite()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Blackjack.razor.js");
            await _module.InvokeVoidAsync("copyInvite", InviteUrl);
            _copied = true;
        }
        catch (JSException)
        {
            _error = "Clipboard access is unavailable. Select and copy the invite link instead.";
        }
    }

    private static string Chips(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Signed(int value) => value.ToString("+0;-0;0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Signed(double value) => value.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static string ActionLabel(BrowserBlackjackCommand action) => action switch
    {
        BrowserBlackjackCommand.Double => "Double down",
        BrowserBlackjackCommand.Insure => "Take insurance",
        BrowserBlackjackCommand.DeclineInsurance => "No insurance",
        _ => action.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();

        if (_updates is not null)
        {
            await _updates;
        }

        _stop.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
