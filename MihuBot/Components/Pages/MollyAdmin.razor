@page "/molly"
@using System.Security.Cryptography
@using MihuBot.Configuration
@using MihuBot.Molly
@* Injected (and otherwise unused) so the router shows the FeatureUnavailable page when Molly is disabled. *@
@inject MollyService molly
@inject IConfigurationService configuration
@rendermode InteractiveServer

<PageTitle>Molly</PageTitle>

<h1>Molly</h1>

@if (_unlocked)
{
    <MollyDashboard CanDelete="_isAdmin" />
}
else
{
    @* Nothing about the registered devices is rendered until the password checks out. *@
    <EditForm Model="Login" OnValidSubmit="Unlock">
        <div class="mb-2" style="max-width: 20rem;">
            <InputText type="password" class="form-control" @bind-Value="Login.Password" placeholder="Password" />
        </div>

        @if (_loginFailed)
        {
            <div class="alert alert-danger" role="alert">
                Incorrect password.
            </div>
        }

        <button type="submit" class="btn btn-primary">Log in</button>
    </EditForm>
}

@code
{
#nullable enable

    /// <summary>Lets a non-admin open the dashboard. Unset means only admins can.</summary>
    private const string PasswordConfigurationKey = "Molly.DashboardPassword";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly LoginModel Login = new();

    private bool _isAdmin;
    private bool _unlocked;
    private bool _loginFailed;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            _isAdmin = (await AuthenticationState).User.IsAdmin();
        }

        _unlocked = _isAdmin;
    }

    private void Unlock()
    {
        _unlocked = CheckPassword(Login.Password);
        _loginFailed = !_unlocked;
        Login.Password = null;
    }

    private bool CheckPassword(string? password) =>
        !string.IsNullOrEmpty(password) &&
        configuration.TryGet(null, PasswordConfigurationKey, out string expected) &&
        CryptographicOperations.FixedTimeEquals(expected, password);

    private sealed class LoginModel
    {
        public string? Password { get; set; }
    }
}
