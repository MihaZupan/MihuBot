@page "/molly"
@using System.Security.Cryptography
@using MihuBot.Configuration
@using MihuBot.Helpers.Crypto
@using MihuBot.Molly
@* Required so the router shows FeatureUnavailable when Molly is disabled. *@
@inject MollyService molly
@inject IConfigurationService configuration
@inject NavigationManager navigation
@rendermode InteractiveServer

<PageTitle>Molly</PageTitle>

<h1>Molly</h1>

@if (_loginLinkFailed)
{
    <div class="alert alert-danger" role="alert">
        This login link is invalid, expired, or no longer allowed. Request a new link from an enabled device.
    </div>
}

@if (_unlocked)
{
    <MollyDashboard IsAdmin="_isAdmin" />
}
else
{
    @* Nothing about the registered devices is rendered until the password checks out. *@
    <EditForm Model="Login" OnValidSubmit="Unlock">
        <div class="mb-2" style="max-width: 20rem;">
            <InputText type="password" class="form-control" @bind-Value="Login.Password" placeholder="Password" />
        </div>

        @if (_loginFailed)
        {
            <div class="alert alert-danger" role="alert">
                Incorrect password.
            </div>
        }

        <button type="submit" class="btn btn-primary">Log in</button>
    </EditForm>
}

@code
{
#nullable enable

    /// <summary>Lets a non-admin open the dashboard. Unset means only admins can.</summary>
    /// <remarks>
    /// The value is a comma separated list, so a password can be rotated (or handed out to more than
    /// one person) without invalidating the others.
    /// </remarks>
    private const string PasswordConfigurationKey = "Molly.DashboardPassword";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromQuery(Name = "login")]
    private string? LoginToken { get; set; }

    private readonly LoginModel Login = new();

    private bool _isAdmin;
    private bool _unlocked;
    private bool _loginFailed;
    private bool _loginLinkFailed;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            _isAdmin = (await AuthenticationState).User.IsAdmin();
        }

        _unlocked = _isAdmin;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only the interactive circuit retains the login. Prerendering must not disclose device data.
        if (!RendererInfo.IsInteractive || string.IsNullOrEmpty(LoginToken))
        {
            return;
        }

        if (!_unlocked)
        {
            _unlocked = await molly.TryDashboardLoginAsync(LoginToken);
            _loginLinkFailed = !_unlocked;
        }

        navigation.NavigateTo(navigation.GetUriWithQueryParameter("login", (string?)null), replace: true);
    }

    private void Unlock()
    {
        _unlocked = CheckPassword(Login.Password);
        _loginFailed = !_unlocked;
        _loginLinkFailed = false;
        Login.Password = null;
    }

    private bool CheckPassword(string? password)
    {
        if (string.IsNullOrEmpty(password) ||
            !configuration.TryGet(null, PasswordConfigurationKey, out string configured))
        {
            return false;
        }

        bool matched = false;

        foreach (Range range in configured.AsSpan().Split(','))
        {
            matched |= CryptographicOperations.FixedTimeEquals(configured.AsSpan(range).Trim(), password);
        }

        return matched;
    }

    private sealed class LoginModel
    {
        public string? Password { get; set; }
    }
}
