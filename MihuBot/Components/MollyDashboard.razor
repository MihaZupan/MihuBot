@using MihuBot.Molly
@using MihuBot.Molly.Alerts
@inject MollyService molly
@implements IDisposable

<p>Registered Molly devices. Locking blocks future logins, wiping additionally destroys the stored secret.</p>

@if (_users.Length == 0)
{
    <div class="alert alert-secondary" role="alert">
        No registered users yet.
    </div>
}
else
{
    <table class="table table-dark">
        <thead>
            <tr>
                <th scope="col">Nickname</th>
                <th scope="col">Registered</th>
                <th scope="col">Last seen</th>
                <th scope="col">Device</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (MollyUserInfo user in _users)
            {
                <tr>
                    <td scope="row">@user.Nickname</td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td title="@user.LastSeenAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                        <span class="elapsed">@((DateTime.UtcNow - user.LastSeenAt).ToElapsedTime()) ago</span>
                    </td>
                    <td>
                        @* Only ever reported by a ping, so a device that never sent one shows nothing. *@
                        @if (user.BatteryLevel is { } battery)
                        {
                            <span class="@BatteryIcon(battery)" title="Battery @(battery)%" aria-hidden="true"></span>
                            <small class="mr-2">@(battery)%</small>
                        }

                        @if (user.LocationEnabled is { } locationEnabled)
                        {
                            @* Bootstrap has no crossed-out geo icon, so "off" is the hollow pin in red. *@
                            <span class="bi @(locationEnabled ? "bi-geo-alt-fill text-info" : "bi-geo-alt text-danger")"
                                  title="@(locationEnabled ? "Location available" : "No location fix")" aria-hidden="true"></span>
                        }
                    </td>
                    <td>
                        @if (user.WipeRequested)
                        {
                            <span class="badge bg-danger">Wipe requested</span>
                        }
                        else if (user.LockRequested)
                        {
                            <span class="badge bg-warning text-dark">Locked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }

                        @if (user.AlertsMuted)
                        {
                            <span class="badge bg-secondary ml-1">Muted</span>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-light mr-2" disabled="@_busy"
                                @onclick="() => SetAlertsMutedAsync(user, !user.AlertsMuted)">
                            @(user.AlertsMuted ? "Unmute alerts" : "Mute alerts")
                        </button>

                        @if (!user.WipeRequested)
                        {
                            <button type="button" class="btn btn-sm btn-warning mr-2" disabled="@_busy"
                                    @onclick="() => SetLockRequestedAsync(user, !user.LockRequested)">
                                @(user.LockRequested ? "Unlock" : "Lock")
                            </button>

                            @if (_pendingWipeId == user.Id)
                            {
                                <button type="button" class="btn btn-sm btn-danger mr-2" disabled="@_busy"
                                        @onclick="() => WipeAsync(user)">
                                    Confirm wipe
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary mr-2" disabled="@_busy"
                                        @onclick="() => _pendingWipeId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-danger mr-2" disabled="@_busy"
                                        title="Shift+click to skip the confirmation"
                                        @onclick="e => ConfirmOrRunAsync(e, () => _pendingWipeId = user.Id, () => WipeAsync(user))">
                                    Wipe
                                </button>
                            }
                        }

                        @if (IsAdmin)
                        {
                            @if (_pendingClearAlertsId == user.Id)
                            {
                                <button type="button" class="btn btn-sm btn-danger mr-2" disabled="@_busy"
                                        @onclick="() => ClearAlertsAsync(user)">
                                    Confirm clear alerts
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary mr-2" disabled="@_busy"
                                        @onclick="() => _pendingClearAlertsId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger mr-2" disabled="@_busy"
                                        title="Shift+click to skip the confirmation"
                                        @onclick="e => ConfirmOrRunAsync(e, () => _pendingClearAlertsId = user.Id, () => ClearAlertsAsync(user))">
                                    Clear alerts
                                </button>
                            }

                            @if (_pendingDeleteId == user.Id)
                            {
                                <button type="button" class="btn btn-sm btn-danger mr-2" disabled="@_busy"
                                        @onclick="() => DeleteAsync(user)">
                                    Confirm delete
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary mr-2" disabled="@_busy"
                                        @onclick="() => _pendingDeleteId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger mr-2" disabled="@_busy"
                                        title="Shift+click to skip the confirmation"
                                        @onclick="e => ConfirmOrRunAsync(e, () => _pendingDeleteId = user.Id, () => DeleteAsync(user))">
                                    Delete
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent alerts</h2>

@if (_alerts.Length == 0)
{
    <div class="alert alert-secondary" role="alert">
        No alerts have been reported.
    </div>
}
else
{
    <table class="table table-dark">
        <thead>
            <tr>
                <th scope="col">Nickname</th>
                <th scope="col">Received</th>
                <th scope="col">Type</th>
                <th scope="col">Details</th>
                @if (IsAdmin)
                {
                    <th scope="col">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (MollyAlertInfo alert in _alerts)
            {
                <tr>
                    <td scope="row">@alert.Nickname</td>
                    <td title="@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC">
                        <span class="elapsed">@((DateTime.UtcNow - alert.CreatedAt).ToElapsedTime()) ago</span>
                    </td>
                    <td>
                        @if (alert.Type != MollyAlertType.Unknown)
                        {
                            <span class="badge bg-secondary">@alert.Type</span>
                        }
                    </td>
                    @* The raw payload is only a hover away - it's noisy, and the summary covers the common case. *@
                    <td title="@alert.Payload">
                        @if (alert.Summary is { } summary)
                        {
                            @if (alert.MapUrl is { } mapUrl)
                            {
                                <a class="badge bg-info text-dark" href="@mapUrl" target="_blank" rel="noopener noreferrer">@summary</a>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">@summary</span>
                            }
                        }
                    </td>
                    @if (IsAdmin)
                    {
                        <td>
                            @if (_pendingDeleteAlertId == alert.Id)
                            {
                                <button type="button" class="btn btn-sm btn-danger mr-2" disabled="@_busy"
                                        @onclick="() => DeleteAlertAsync(alert)">
                                    Confirm delete
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary mr-2" disabled="@_busy"
                                        @onclick="() => _pendingDeleteAlertId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger mr-2" disabled="@_busy"
                                        title="Shift+click to skip the confirmation"
                                        @onclick="e => ConfirmOrRunAsync(e, () => _pendingDeleteAlertId = alert.Id, () => DeleteAlertAsync(alert))">
                                    Delete
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code
{
#nullable enable

    /// <summary>
    /// Whether the viewer is an actual admin rather than someone who only knew the dashboard password.
    /// Deleting is admin-only, and everything else an admin does is trusted without being announced.
    /// </summary>
    [Parameter]
    public bool IsAdmin { get; set; }

    /// <summary>Bootstrap only ships four battery icons, so the level is bucketed to the nearest one.</summary>
    private static string BatteryIcon(int level) => level switch
    {
        <= 10 => "bi bi-battery text-danger",
        <= 35 => "bi bi-battery-half text-warning",
        < 80 => "bi bi-battery-half",
        _ => "bi bi-battery-full text-success",
    };

    private MollyUserInfo[] _users = [];
    private MollyAlertInfo[] _alerts = [];
    private Guid? _pendingWipeId;
    private Guid? _pendingDeleteId;
    private Guid? _pendingClearAlertsId;
    private long? _pendingDeleteAlertId;
    private bool _busy;

    /// <summary>Keeps the device list and alerts current without a manual reload.</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(1);
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        // Mirrors the runtime-utils dashboard: seed a throw-away entry so there's something to look
        // at when developing locally. Linux is the real deployment.
        if (OperatingSystem.IsWindows() && (await molly.GetRegisteredUsersAsync()).Length == 0)
        {
            await molly.CreateFakeEntryAsync("Dummy");
        }

        await RefreshAsync();

        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(RefreshInterval);

                while (await timer.WaitForNextTickAsync(_cts.Token))
                {
                    // Skip a tick mid-action so the refresh can't disturb a pending confirm.
                    await InvokeAsync(async () =>
                    {
                        if (_busy)
                        {
                            return;
                        }

                        await RefreshAsync();
                        StateHasChanged();
                    });
                }
            }
            catch { }
        });
    }

    private async Task RefreshAsync()
    {
        _users = await molly.GetRegisteredUsersAsync();
        _alerts = await molly.GetRecentAlertsAsync();
    }

    /// <summary>
    /// Destructive actions normally swap in a confirm button first. Holding shift skips that step
    /// for anyone who already knows what they're doing.
    /// </summary>
    private Task ConfirmOrRunAsync(MouseEventArgs e, Action setPending, Func<Task> operation)
    {
        if (e.ShiftKey)
        {
            return operation();
        }

        setPending();
        return Task.CompletedTask;
    }

    private async Task SetLockRequestedAsync(MollyUserInfo user, bool lockRequested)
    {
        await RunAsync(lockRequested ? "lock" : "unlock", () => molly.SetLockRequestedAsync(user.Id, lockRequested));
    }

    private async Task SetAlertsMutedAsync(MollyUserInfo user, bool muted)
    {
        await RunAsync(muted ? "mute alerts" : "unmute alerts", () => molly.SetAlertsMutedAsync(user.Id, muted));
    }

    private async Task WipeAsync(MollyUserInfo user)
    {
        await RunAsync("wipe", () => molly.RequestWipeAsync(user.Id));
    }

    private async Task DeleteAsync(MollyUserInfo user)
    {
        // Re-checked here as well: the button is only rendered for admins, but the event it raises isn't.
        if (!IsAdmin)
        {
            return;
        }

        await RunAsync("delete", () => molly.DeleteEntryAsync(user.Id));
    }

    private async Task ClearAlertsAsync(MollyUserInfo user)
    {
        // Re-checked here as well: the button is only rendered for admins, but the event it raises isn't.
        if (!IsAdmin)
        {
            return;
        }

        await RunAsync("clear alerts", () => molly.DeleteAlertsAsync(user.Id));
    }

    private async Task DeleteAlertAsync(MollyAlertInfo alert)
    {
        // Re-checked here as well: the button is only rendered for admins, but the event it raises isn't.
        if (!IsAdmin)
        {
            return;
        }

        await RunAsync("delete alert", () => molly.DeleteAlertAsync(alert.Id));
    }

    private async Task RunAsync(string action, Func<Task> operation)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            await operation();

            // Only an admin is trusted implicitly. Anything done with just the dashboard password is
            // announced, so a leaked password can't be used to quietly lock or wipe someone's device.
            if (!IsAdmin)
            {
                await molly.ReportPasswordDashboardActionAsync(action);
            }

            _pendingWipeId = null;
            _pendingDeleteId = null;
            _pendingClearAlertsId = null;
            _pendingDeleteAlertId = null;
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _cts.Cancel();
}
