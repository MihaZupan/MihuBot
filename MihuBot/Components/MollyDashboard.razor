    private sealed record SetupCodeView(MollySetupCode Code, string QrCode, DateTime ExpiresAt);

    private SetupCodeView? _setupCode;

    /// <summary>Not rate limited, unlike setup codes created by devices.</summary>
    private void CreateSetupCode()
    {
        MollyRegistrationToken token = molly.RegistrationTokens.IssueForDashboard();

        // The address the dashboard was opened at, which the device can reach as well.
        string apiUrl = new Uri(new Uri(navigation.BaseUri), "api/molly").ToString();

        MollySetupCode code = MollySetupCode.Create(apiUrl, protector.GetTransportKey().DiscoveryPublicKey, token.Token);

        _setupCode = new SetupCodeView(code, code.ToQrCodeDataUri(), token.ExpiresAt);
    }

    private async Task RunAsync(string action, Func<Task> operation)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;

        try
        {
            await operation();

            // Non-admin actions are announced, whether logged in with a password or a device link.
            if (!IsAdmin)
            {
                await molly.ReportPasswordDashboardActionAsync(action);
            }

            _pendingWipeId = null;
            _pendingDeleteId = null;
            _pendingClearAlertsId = null;
            _pendingDeleteAlertId = null;
            _pendingDeleteShareId = null;
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => _cts.Cancel();
}
